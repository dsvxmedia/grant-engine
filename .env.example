# Grant Engine — Environment Variables
# Copy this file to .env.local and fill in your values.
# See CONTRIBUTING.md for how to obtain each value.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Your Supabase project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (Settings → API → anon/public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — keep secret, server-only (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Clerk Auth ───────────────────────────────────────────────────────────────
# Clerk dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# ─── AI Models ────────────────────────────────────────────────────────────────
# Anthropic console.anthropic.com → API Keys
# Used for: grant discovery classification (Haiku), writing pipeline (Sonnet), QA gate (Opus)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# OpenAI — optional, enables semantic grant matching via text-embedding-3-small (~$0.013/month)
# Without this key the system falls back to keyword-token matching (still works, just less precise)
# platform.openai.com → API Keys
OPENAI_API_KEY=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=re_your-resend-api-key

# From email address (must be verified in Resend)
RESEND_FROM_EMAIL=grants@yourdomain.com

# Alert email for system notifications
RESEND_ALERT_EMAIL=alerts@yourdomain.com

# ─── Optional ─────────────────────────────────────────────────────────────────

# Vercel Blob storage — for exported application documents
# vercel.com → Storage → Blob → Create Store
BLOB_READ_WRITE_TOKEN=

# Cron job protection secret — required if running cron jobs in production
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Google Custom Search — for funder research in the writing pipeline
# console.cloud.google.com → APIs → Custom Search JSON API
# Free tier: 100 queries/day
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

# ─── SAM.gov (SBIR scraper) ───────────────────────────────────────────────────
# Required to run the SBIR/STTR scraper. Register at https://sam.gov/content/entity-information
# Without this key the SBIR scraper silently skips and returns no grants.
SAM_GOV_API_KEY=

# ─── V3 Video Pipeline (optional) ────────────────────────────────────────────
# HeyGen avatar — dashboard.heygen.com → API Keys
HEYGEN_API_KEY=
# Your avatar ID (HeyGen dashboard → Avatars → copy ID)
HEYGEN_AVATAR_ID=

# ElevenLabs voice clone — elevenlabs.io → API Keys
ELEVENLABS_API_KEY=
# Your voice ID (ElevenLabs → Voice Lab → copy ID)
ELEVENLABS_VOICE_ID=

# ─── Demo Mode ────────────────────────────────────────────────────────────────
# Set to "true" for a read-only public demo instance.
# All POST/PUT/PATCH/DELETE API calls return 423 when enabled.
# Use with a dedicated Supabase project seeded from supabase/seed.demo.sql.
# AI and email keys are still validated at startup — use stub values in demo:
#   ANTHROPIC_API_KEY=sk-ant-demo
#   RESEND_API_KEY=re_demo
#   RESEND_FROM_EMAIL=demo@example.com
#   RESEND_ALERT_EMAIL=demo@example.com
DEMO_MODE=

# ─── Development bypass (local only) ─────────────────────────────────────────
# Set to "true" to skip Clerk auth for local QA without signing in.
# Never set in production — the NODE_ENV check enforces this.
NEXT_PUBLIC_DEV_BYPASS=
